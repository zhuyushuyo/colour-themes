{
  "version": 3,
  "updated": "2026-11-28",
  "about": "Colour themes for the owner's apps, slides and documents. Every theme has a dark and a light palette with the same role names. `themes` are the six weekday themes; `app_themes` belong to one app each.",
  "modes": {
    "dark": "Dark background, light text. The accent is a pale, bright colour.",
    "light": "Tinted paper, the theme's dark colour as ink, and the same accent hue made deeper so it can be read on paper."
  },
  "roles": {
    "bg": "window or slide background",
    "side": "sidebar, a shade darker than bg",
    "surf": "cards and panels",
    "surf2": "raised or highlighted panels",
    "line": "hairlines and borders",
    "line_strong": "borders of inputs and controls",
    "text": "body text and headings",
    "text2": "secondary text",
    "text3": "labels and hints (still 4.5:1)",
    "accent": "the theme's one accent: links, active marks, key numbers",
    "accent_soft": "accent at 14% (dark) or 12% (light) for soft fills",
    "nav_on": "soft fill for the active item (accent at 12% in dark, ink at 7% in light)",
    "btn": "primary button fill (the accent in dark, the ink in light)",
    "btn_ink": "text on the primary button",
    "track": "empty part of a meter",
    "good": "success and connected",
    "app": "second data colour",
    "script": "third data colour",
    "warn": "what a person must check: a state, never a second accent. Always beside a word or a mark"
  },
  "weekdays": {
    "mon": "tsukiakari",
    "tue": "sumi",
    "wed": "umi",
    "thu": "chikurin",
    "fri": "yozakura",
    "sat": "fuji",
    "sun": null
  },
  "sunday": "Sunday is a day of rest: no theme of its own. An app shows the base theme the owner chose.",
